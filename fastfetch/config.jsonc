// Shell greeting: a coloured ASCII mountain (Rainier-style dome with a Little
// Tahoma bump and a Shastina-style second cone) beside a short system summary.
// mountain.ansi is generated by mountain.py; edit the script, not the file.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "~/dotfiles/fastfetch/mountain.ansi",
        "padding": {
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "keys": "1;38;2;34;139;34" // bold forest green, matching eza and zellij
        }
    },
    "modules": [
        // Two blank lines centre the ten info lines against the 14-row mountain.
        "break",
        "break",
        {
            "type": "title",
            "color": {
                "user": "1;38;2;34;139;34", // forest green
                "at": "38;2;139;143;154", // grey rock
                "host": "1;38;2;159;211;240" // glacier ice
            }
        },
        "os",
        "kernel",
        "uptime",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory"
    ]
}
